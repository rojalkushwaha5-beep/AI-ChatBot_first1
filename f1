def getresponse(UserQuestion):
    UserQuestion=UserQuestion.lower()
    for i in respon:
        if i in UserQuestion:
            return respon[i]
    if "time" in UserQuestion:
        return "Current Time: " + datetime.now().strftime("%I:%M:%S %p")
    if "date" in UserQuestion:
        return "Today's Date: " + datetime.now().strftime("%d-%m-%Y")
    if "open google" in UserQuestion:
        webbrowser.open("https://www.google.com")
        return "Opening Google..."
    if "open youtube" in UserQuestion:
        webbrowser.open("https://www.youtube.com")
        return "Opening YouTube..."
    if UserQuestion.startswith("search "):
        query = UserQuestion.replace("search ", "")
        webbrowser.open(f"https://www.google.com/search?q={query}")
        return f"Searching Google for {query}"
    if "open chatgpt" in UserQuestion:
        webbrowser.open("https://chatgpt.com")
        return "Opening ChatGPT..."


